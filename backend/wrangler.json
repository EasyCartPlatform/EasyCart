          "invocation_logs": true,
          "persist": true
        },
        "traces": {
          "enabled": true,
          "head_sampling_rate": 1,
          "persist": true
        },
        "issues": {
          "enabled": false
        }
      },
      "previews": {
        "observability": {
          "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
          },
          "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
          },
          "issues": {
            "enabled": false
          }
        }
      }
    },
    "prod": {
      "name": "easycart-api-prod",
