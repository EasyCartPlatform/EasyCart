{
  "name": "easycart-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server-main.js",
    "start": "node src/server-main.js",
    "test": "vitest run",
    "db:clear": "node scripts/clear-supabase-data.js",
    "db:clear-test-data": "node scripts/clear-test-data.js",
    "test:unit": "vitest run --config vitest-unit.config.js",
    "test:integration": "vitest run --config vitest-integration.config.js",
    "worker:check": "wrangler deploy --env dev --dry-run --outdir .worker-build",
    "worker:dev": "wrangler dev --env dev",
    "worker:smoke": "node scripts/worker-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.0.4",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "iconv-lite": "^0.7.2"
  }
}
